{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "0040ad32-7521-4fca-9612-86d2616a565c",
   "metadata": {},
   "source": [
    "# Parameter-Efficient Fine-Tuning with Low-Rank Adaptation (LoRA)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b10a2c12-1363-40b0-8b0a-0b6a34e53535",
   "metadata": {},
   "outputs": [],
   "source": [
    "from datasets import load_dataset\n",
    "\n",
    "dataset = load_dataset(\"Yelp/yelp_review_full\")\n",
    "\n",
    "print(dataset)\n",
    "print(dataset[\"train\"][0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a9578ed8-9e69-49be-90b1-58cbdcc23b9a",
   "metadata": {},
   "outputs": [],
   "source": [
    "split = dataset[\"train\"].train_test_split(test_size=0.2, seed=42)\n",
    "train_val = split[\"train\"].train_test_split(test_size=0.1, seed=42)\n",
    "\n",
    "train_dataset = train_val[\"train\"]\n",
    "val_dataset = train_val[\"test\"]\n",
    "test_dataset = split[\"test\"]\n",
    "\n",
    "print(f\"Train: {len(train_dataset)}, Val: {len(val_dataset)}, Test: {len(test_dataset)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b184092e-72c1-4b86-b27f-e73fdba2aee5",
   "metadata": {},
   "outputs": [],
   "source": [
    "from transformers import AutoTokenizer\n",
    "\n",
    "model_name = \"distilbert-base-uncased\"   # swap for any model on the Hub\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "\n",
    "def tokenize_function(examples):\n",
    "    return tokenizer(\n",
    "        examples[\"text\"],\n",
    "        padding=\"max_length\",\n",
    "        truncation=True,\n",
    "        max_length=256\n",
    "    )\n",
    "\n",
    "tokenized_train = train_dataset.map(tokenize_function, batched=True)\n",
    "tokenized_val = val_dataset.map(tokenize_function, batched=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7fe823dd-a420-4a65-a190-6fd8447872ab",
   "metadata": {},
   "outputs": [],
   "source": [
    "from transformers import DataCollatorWithPadding\n",
    "\n",
    "data_collator = DataCollatorWithPadding(tokenizer=tokenizer)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3ad8a4a6-736b-4944-b1b9-f4acdbf47090",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import evaluate\n",
    "\n",
    "accuracy_metric = evaluate.load(\"accuracy\")\n",
    "f1_metric = evaluate.load(\"f1\")\n",
    "\n",
    "def compute_metrics(eval_pred):\n",
    "    logits, labels = eval_pred\n",
    "    predictions = np.argmax(logits, axis=-1)\n",
    "\n",
    "    accuracy = accuracy_metric.compute(\n",
    "        predictions=predictions,\n",
    "        references=labels,\n",
    "    )\n",
    "    f1 = f1_metric.compute(\n",
    "        predictions=predictions,\n",
    "        references=labels,\n",
    "        average=\"weighted\",\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"accuracy\": accuracy[\"accuracy\"],\n",
    "        \"f1\": f1[\"f1\"],\n",
    "    }"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "caee4fd5-ee5d-48d3-bbec-b4161f344b39",
   "metadata": {},
   "source": [
    "# Setting Up LoRA with PEFT"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7a23a9f4-96ce-4ba3-a0eb-60688f8a0c61",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "from transformers import (\n",
    "    AutoModelForSequenceClassification,\n",
    ")\n",
    "from peft import (\n",
    "    LoraConfig,\n",
    "    get_peft_model,\n",
    "    TaskType,\n",
    ")\n",
    "\n",
    "base_model = (\n",
    "    AutoModelForSequenceClassification\n",
    "    .from_pretrained(\n",
    "        \"distilbert-base-uncased\",\n",
    "        num_labels=5,\n",
    "    )\n",
    ")\n",
    "\n",
    "lora_config = LoraConfig(\n",
    "    task_type=TaskType.SEQ_CLS,\n",
    "    r=8,\n",
    "    # rank of the low-rank matrices —\n",
    "    # the key size/quality tradeoff knob\n",
    "    lora_alpha=16,\n",
    "    # scaling factor, conventionally\n",
    "    # set to 2x the rank\n",
    "    lora_dropout=0.1,\n",
    "    target_modules=[\"q_lin\", \"v_lin\"],\n",
    "    # which weight matrices to\n",
    "    # attach LoRA adapters to\n",
    ")\n",
    "\n",
    "model = get_peft_model(\n",
    "    base_model, lora_config\n",
    ")\n",
    "model.print_trainable_parameters()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c7ec73af-1988-4a62-af56-652aa499bb31",
   "metadata": {},
   "source": [
    "# Training a LoRA Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "69e6aa7a-e685-494b-bbbf-4fb3dc977986",
   "metadata": {},
   "outputs": [],
   "source": [
    "from transformers import TrainingArguments, Trainer\n",
    "\n",
    "training_args = TrainingArguments(\n",
    "    output_dir=\"./lora-output\",\n",
    "    eval_strategy=\"epoch\",\n",
    "    save_strategy=\"epoch\",\n",
    "    learning_rate=1e-4,             # LoRA typically tolerates/needs a higher LR than full fine-tuning\n",
    "    per_device_train_batch_size=16,\n",
    "    per_device_eval_batch_size=32,\n",
    "    num_train_epochs=5,             # LoRA often benefits from a few more epochs than full fine-tuning\n",
    "    weight_decay=0.01,\n",
    "    load_best_model_at_end=True,\n",
    "    metric_for_best_model=\"f1\",\n",
    "    logging_steps=50,\n",
    "    report_to=\"none\",\n",
    ")\n",
    "\n",
    "trainer = Trainer(\n",
    "    model=model,\n",
    "    args=training_args,\n",
    "    train_dataset=tokenized_train,\n",
    "    eval_dataset=tokenized_val,\n",
    "    data_collator=data_collator,\n",
    "    compute_metrics=compute_metrics,\n",
    ")\n",
    "\n",
    "trainer.train()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "09b32df0-41c7-4c77-9187-5faee98bdbf3",
   "metadata": {},
   "source": [
    "# Saving and Reusing LoRA Adapters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7505b3ad-b350-4331-aa57-34d937b0cb7b",
   "metadata": {},
   "outputs": [],
   "source": [
    "model.save_pretrained(\"./my-lora-adapter\")   # typically a few MB, not GBs"    
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b9eba15e-e2a5-4047-8d52-039e6de3cc24",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "from transformers import AutoModelForSequenceClassification\n",
    "from peft import PeftModel\n",
    "\n",
    "base_model = AutoModelForSequenceClassification.from_pretrained(\n",
    "    \"distilbert-base-uncased\", num_labels=5\n",
    ")\n",
    "model = PeftModel.from_pretrained(base_model, \"./my-lora-adapter\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "36d9a448-6d2f-4764-a0f1-27c7a33c178a",
   "metadata": {},
   "source": [
    "# Merging Adapters for Deployment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ce30f489-f998-4e99-84e5-4aed9930daed",
   "metadata": {},
   "outputs": [],
   "source": [
    "merged_model = model.merge_and_unload()\n",
    "merged_model.save_pretrained(\"./my-merged-model\")\n"
    "tokenizer.save_pretrained(\"./my-merged-model\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c46e287d-cdf3-46d1-be57-08330f6a2e40",
   "metadata": {},
   "source": [
    "# Using the Merged Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6f0c74fe-f4ac-4b02-847d-d1593af940f8",
   "metadata": {},
   "outputs": [],
   "source": [
    "from transformers import (\n",
    "    AutoTokenizer,\n",
    ")\n",
    "import torch\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(\n",
    "    \"distilbert-base-uncased\"\n",
    ")\n",
    "\n",
    "text = \"The food was amazing!\"\n",
    "inputs = tokenizer(\n",
    "    text,\n",
    "    return_tensors=\"pt\",\n",
    "    truncation=True,\n",
    ")\n",
    "\n",
    "merged_model.eval()\n",
    "with torch.no_grad():\n",
    "    outputs = merged_model(**inputs)\n",
    "\n",
    "predicted_id = outputs.logits.argmax(\n",
    "    dim=-1\n",
    ").item()\n",
    "\n",
    "print(f\"Predicted class: {predicted_id}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a79d544a-f568-4ae9-9c65-4ddcbeca1884",
   "metadata": {},
   "outputs": [],
   "source": []
  }
